{
  "name": "@faso-ui/react",
  "private": false,
  "version": "1.0.0",
  "description": "Composants React accessibles pour les services publics numériques du Burkina Faso.",
  "license": "MIT",
  "sideEffects": ["**/*.css"],
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": { "types": "./dist/types/index.d.ts", "import": "./dist/index.js" },
    "./styles.css": "./dist/faso-ui.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": { "react": ">=18", "react-dom": ">=18" },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:site && npm run build:lib",
    "build:site": "tsc -b && vite build --outDir dist-site",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:a11y": "vitest run src/test/accessibility.test.tsx",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jest-axe": "3.5.9",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "postcss": "8.5.22",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "jsdom": "26.1.0",
    "jest-axe": "10.0.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "3.2.4"
  }
}
