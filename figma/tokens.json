{
  "$description": "Tokens FasoDesign destinés à être importés dans Figma Variables. Les valeurs sont alignées sur src/design-system/tokens.css et typography.css.",
  "color": {
    "primitive": {
      "brand": { "700": { "$type": "color", "$value": "#006A45" }, "600": { "$type": "color", "$value": "#00784E" }, "100": { "$type": "color", "$value": "#E8F1ED" } },
      "neutral": { "950": { "$type": "color", "$value": "#1E2A24" }, "600": { "$type": "color", "$value": "#5F6B65" }, "200": { "$type": "color", "$value": "#D9DFDC" } },
      "danger": { "700": { "$type": "color", "$value": "#B3202E" } },
      "warning": { "500": { "$type": "color", "$value": "#F4D35E" } },
      "white": { "$type": "color", "$value": "#FFFFFF" }
    },
    "semantic": {
      "$extensions": { "modeOrder": ["Light", "Dark"] },
      "background": { "$type": "color", "$value": { "Light": "#FFFFFF", "Dark": "#111714" } },
      "foreground": { "$type": "color", "$value": { "Light": "#1E2A24", "Dark": "#F2F5F1" } },
      "surface": { "$type": "color", "$value": { "Light": "#FFFFFF", "Dark": "#18201C" } },
      "primary": { "$type": "color", "$value": { "Light": "#006A45", "Dark": "#55C995" } },
      "on-primary": { "$type": "color", "$value": { "Light": "#FFFFFF", "Dark": "#071A12" } },
      "secondary": { "$type": "color", "$value": { "Light": "#E8F1ED", "Dark": "#25372F" } },
      "muted": { "$type": "color", "$value": { "Light": "#F3F5F4", "Dark": "#26302B" } },
      "muted-foreground": { "$type": "color", "$value": { "Light": "#5F6B65", "Dark": "#AEB8B1" } },
      "success": { "$type": "color", "$value": { "Light": "#00784E", "Dark": "#5ED39A" } },
      "danger": { "$type": "color", "$value": { "Light": "#B3202E", "Dark": "#D95765" } },
      "warning": { "$type": "color", "$value": { "Light": "#F4D35E", "Dark": "#F2CA60" } },
      "border": { "$type": "color", "$value": { "Light": "#D9DFDC", "Dark": "#303B35" } },
      "focus": { "$type": "color", "$value": { "Light": "#006A45", "Dark": "#55C995" } }
    }
  },
  "spacing": {
    "1": { "$type": "dimension", "$value": "4px" }, "2": { "$type": "dimension", "$value": "8px" }, "3": { "$type": "dimension", "$value": "12px" }, "4": { "$type": "dimension", "$value": "16px" }, "5": { "$type": "dimension", "$value": "24px" }, "6": { "$type": "dimension", "$value": "32px" }, "7": { "$type": "dimension", "$value": "48px" }, "8": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" }, "md": { "$type": "dimension", "$value": "6px" }, "lg": { "$type": "dimension", "$value": "8px" }, "default": { "$type": "dimension", "$value": "10px" }
  },
  "typography": {
    "font-family": { "$type": "fontFamily", "$value": ["Manrope", "Avenir Next", "Segoe UI", "Helvetica Neue", "sans-serif"] },
    "body": { "$type": "typography", "$value": { "fontFamily": "{typography.font-family}", "fontSize": "16px", "fontWeight": 400, "lineHeight": 1.5 } },
    "heading": { "$type": "typography", "$value": { "fontFamily": "{typography.font-family}", "fontSize": "30px", "fontWeight": 700, "lineHeight": 1.1 } }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "150ms" }, "base": { "$type": "duration", "$value": "200ms" }, "slow": { "$type": "duration", "$value": "320ms" }
  }
}
